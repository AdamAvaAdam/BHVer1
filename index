<!doctype html>
<html lang="vi">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Việt Tuấn · Báo giá nhanh</title>
<style>
:root{font-family:Segoe UI,Arial,sans-serif;color:#17283d;background:#f1f5f9}*{box-sizing:border-box}body{margin:0;padding-bottom:90px}header{background:#123d71;color:white;padding:16px max(16px,calc((100% - 1180px)/2));display:flex;justify-content:space-between;gap:15px;align-items:center}h1{font-size:20px;margin:0 0 4px}small{font-size:12px}main{max-width:1180px;margin:auto;padding:12px}.toolbar{position:sticky;top:0;background:#f1f5f9;z-index:2;padding:8px 0;display:flex;gap:8px;flex-wrap:wrap}input[type=search]{flex:1;min-width:220px;padding:13px;border:1px solid #c8d4e0;border-radius:9px;font-size:16px}button,select{font:inherit;border:1px solid #c8d4e0;border-radius:7px;padding:9px 12px;background:white;color:#183b64;cursor:pointer}button:hover{background:#eaf2fc}button:disabled{opacity:.5;cursor:wait}.primary{background:#1764cc;color:white;border-color:#1764cc}.primary:hover{background:#104eaa}.chips{display:flex;gap:6px;overflow:auto;padding:3px 0 10px}.chips button{white-space:nowrap;font-size:13px}.chips .active{background:#183f70;color:white}.status{font-size:12px;line-height:1.6;color:#53657b;margin:5px 0 12px}.error{color:#af2929}.list{display:grid;gap:10px}.card{border:1px solid #d5dfea;border-radius:10px;background:white;overflow:hidden}.card.selected{border-color:#1764cc;box-shadow:0 0 0 1px #1764cc}.row{display:grid;grid-template-columns:28px 1fr 110px 190px;align-items:start;gap:12px;padding:15px}.check{width:19px;height:19px;margin:4px 0;cursor:pointer}.model{font-size:17px;font-weight:750;color:#143f75}.name{font-size:14px;margin:4px 0}.spec{font-size:12px;color:#627187;white-space:pre-line}.stock{font-size:14px;font-weight:600}.muted{color:#7b8796}.price{font-weight:750;font-size:20px;color:#bd3028}.program{font-size:12px;white-space:pre-line;margin:5px 0 8px;color:#506078}.badge{display:inline-block;font-size:11px;background:#fff0ce;color:#855200;padding:3px 6px;border-radius:4px;margin-top:6px}.tools{display:flex;gap:6px;flex-wrap:wrap;margin-top:9px}.tools button{font-size:12px;padding:6px 8px}.sub{margin:0 15px 12px;padding-top:8px;border-top:1px solid #e1e8f0}.subline{display:grid;grid-template-columns:28px 150px 1fr auto;gap:10px;align-items:center;padding:9px 0;border-bottom:1px solid #edf1f6}.subline:last-child{border:0}.subprice{font-weight:700}.best{color:#bd3028}.empty{padding:40px;text-align:center;background:white;border-radius:10px;color:#617086}footer{position:fixed;bottom:0;left:0;right:0;background:#12345a;color:white;display:flex;align-items:center;justify-content:space-between;padding:12px max(16px,calc((100% - 1180px)/2));gap:10px;z-index:3}footer div{display:flex;gap:8px;align-items:center}#toast{position:fixed;bottom:85px;left:50%;transform:translateX(-50%);background:#17283d;color:white;border-radius:8px;padding:12px 18px;z-index:10;max-width:90%;display:none}dialog{border:0;border-radius:12px;width:min(580px,94vw);padding:20px}dialog::backdrop{background:#0008}textarea{width:100%;min-height:220px;font:14px Segoe UI;padding:10px;margin:12px 0;border:1px solid #bccbdc;border-radius:6px}dialog h2{font-size:18px;margin-top:0}@media(max-width:650px){header{padding:13px}h1{font-size:18px}.row{grid-template-columns:25px 1fr;gap:8px;padding:12px}.stock{grid-column:2}.quote{grid-column:2}.price{font-size:21px}.subline{grid-template-columns:24px 1fr auto}.subline .program{grid-column:2 / 4;grid-row:2}.toolbar button,.toolbar select{font-size:12px;padding:8px}footer{padding:10px;font-size:12px}footer button{font-size:12px;padding:10px}.sub{margin:0 12px 10px}}
</style>
<header><div><h1>VIỆT TUẤN · BÁO GIÁ NHANH</h1><small>Tra mã · Xem tồn · Copy giá</small></div><button id="reload">↻ MỚI</button></header>
<main>
<div class="toolbar"><input id="search" type="search" placeholder="Tìm mã, tên hàng, thông số…" autocomplete="off"><select id="stockFilter"><option value="available">Còn hàng</option><option value="all">Tất cả tồn</option><option value="unknown">Chưa rõ tồn</option></select><button id="selectAll">Chọn tất cả</button></div>
<div class="chips" id="chips"></div><div class="status" id="status" role="status">Đang tải dữ liệu…</div><div class="list" id="list"></div>
</main>
<footer><span>Đã chọn: <b id="count">0</b> mức giá</span><div><button id="reset">Bỏ chọn</button><button class="primary" id="copySelected">📋 COPY BÁO GIÁ</button></div></footer>
<div id="toast" role="status"></div>
<dialog id="manual"><h2>Copy nội dung</h2><div>Trình duyệt chưa cho phép copy tự động. Chọn nội dung bên dưới để sao chép.</div><textarea id="manualText" readonly></textarea><button id="closeManual">Đóng</button></dialog>
<dialog id="specDialog"><h2 id="specTitle">Thông số riêng trên thiết bị</h2><small>Để trống rồi lưu để dùng lại thông số từ Sheets.</small><textarea id="specInput"></textarea><button id="saveSpec" class="primary">Lưu</button> <button id="cancelSpec">Hủy</button></dialog>
<script>
'use strict';
const BASE='https://docs.google.com/spreadsheets/d/e/2PACX-1vS1k5jVGEaXBRv9EOrUqSiTDJ7IrwWHIsTl3KrnYWArTrpZ17gLORwN06RqLUI6Y7My_Xs6OL6Es1Bl/pub?single=true&output=csv&gid=';
const SOURCES={stock:BASE+'656473693',price:BASE+'1327420648',specs:BASE+'1649169229'};
const $=id=>document.getElementById(id);
const key=s=>String(s??'').normalize('NFKC').trim().toUpperCase().replace(/[\s\-‐‑–—]/g,'');
const fold=s=>String(s??'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d').replace(/Đ/g,'D').toLowerCase();
const compact=s=>fold(s).replace(/[^a-z0-9]/g,'');
const money=n=>n.toLocaleString('vi-VN')+'đ';
let items=[],visible=[],selected=new Set(),opened=new Set(),brand='',loading=false,editing=null,lastSync='',loadNote='';
let custom={};try{const v=JSON.parse(localStorage.getItem('CUSTOM_SPECS_CACHE')||'{}');if(v&&typeof v==='object'&&!Array.isArray(v))custom=v;}catch{}
function parseCSV(text){
 const rows=[];let row=[],cell='',quoted=false;
 for(let i=0;i<text.length;i++){const c=text[i];if(c==='"'){if(quoted&&text[i+1]==='"'){cell+='"';i++;}else quoted=!quoted;}else if(c===','&&!quoted){row.push(cell.trim());cell='';}else if((c==='\n'||c==='\r')&&!quoted){if(c==='\r'&&text[i+1]==='\n')i++;row.push(cell.trim());if(row.some(Boolean))rows.push(row);row=[];cell='';}else cell+=c;}
 if(quoted)throw Error('CSV có ô chưa đóng dấu ngoặc kép');row.push(cell.trim());if(row.some(Boolean))rows.push(row);if(rows[0])rows[0][0]=rows[0][0].replace(/^\uFEFF/,'');return rows;
}
function stockNumber(s){let t=String(s??'').trim().replace(/\s/g,'');if(!t)return null;if(!/^-?[\d.,]+$/.test(t))return null;if(t.includes(',')&&t.includes('.'))t=t.replace(/\./g,'').replace(',','.');else if(t.includes(','))t=t.replace(',','.');else if(/^-?\d{1,3}(\.\d{3})+$/.test(t))t=t.replace(/\./g,'');const n=Number(t);return Number.isFinite(n)?n:null;}
function priceNumber(s){const t=String(s??'').trim();if(!/^\d[\d.,\s]*(?:đ|₫|vnd)?$/i.test(t))return null;const n=Number(t.replace(/[^\d]/g,''));return Number.isSafeInteger(n)&&n>0?n:null;}
function isToday(s){const m=String(s).match(/^(\d{1,2})[\/.-](\d{1,2})[\/.-](\d{2}|\d{4})(?:\s|$)/);if(!m)return false;const parts=new Intl.DateTimeFormat('en-GB',{timeZone:'Asia/Bangkok',day:'2-digit',month:'2-digit',year:'numeric'}).format(new Date()).split('/');return +m[1]===+parts[0]&&+m[2]===+parts[1]&&(+m[3]<100?2000+(+m[3]):+m[3])===+parts[2];}
function el(tag,cls,text){const n=document.createElement(tag);if(cls)n.className=cls;if(text!==undefined)n.textContent=text;return n;}
function button(text,fn,cls){const b=el('button',cls,text);b.type='button';b.addEventListener('click',fn);return b;}
function toast(s){$('toast').textContent=s;$('toast').style.display='block';clearTimeout(toast.timer);toast.timer=setTimeout(()=>$('toast').style.display='none',2600);}
async function fetchCSV(url){const controller=new AbortController();const timer=setTimeout(()=>controller.abort(),25000);try{const r=await fetch(url,{cache:'no-store',signal:controller.signal});if(!r.ok)throw Error('HTTP '+r.status);const t=await r.text();if(/^\s*</.test(t))throw Error('Nguồn không trả về CSV');return parseCSV(t);}finally{clearTimeout(timer);}}
function buildData(stockRows,priceRows,specRows){
 const stocks=new Map(),specs=new Map(),groups=new Map();let invalid=0,duplicates=0;
 for(const c of stockRows.slice(1)){const k=key(c[0]);if(!k)continue;const n=stockNumber(c[3]);if(stocks.has(k)){stocks.set(k,null);duplicates++;}else stocks.set(k,n);}
 for(const c of specRows.slice(1)){if(key(c[0]))specs.set(key(c[0]),c[2]||'');}
 const occurrences=new Map();
 for(const c of priceRows.slice(1)){const k=key(c[0]);if(!k)continue;const price=priceNumber(c[5]);if(price===null){invalid++;continue;}const name=c[1]||c[0],km=c[8]||'-',date=c[6]||'';
 const signature=JSON.stringify([k,price,km,date]);const occurrence=(occurrences.get(signature)||0)+1;occurrences.set(signature,occurrence);
 const p={id:signature+'#'+occurrence,price,km,date,newToday:isToday(date)};
 if(!groups.has(k))groups.set(k,{key:k,model:c[0],name,stock:stocks.has(k)?stocks.get(k):null,sheetSpec:specs.get(k)||'',programs:[]});groups.get(k).programs.push(p);
 }
 for(const i of groups.values()){i.programs.sort((a,b)=>b.price-a.price);i.default=i.programs.find(p=>fold(p.km).includes('le'))||i.programs[0];i.min=Math.min(...i.programs.map(p=>p.price));i.spec=custom[i.key]||custom[String(i.model).trim().toUpperCase().normalize()]||i.sheetSpec;}
 return {data:[...groups.values()],invalid,duplicates};
}
async function load(){if(loading)return;loading=true;$('reload').disabled=true;$('copySelected').disabled=true;$('status').textContent='Đang cập nhật giá và tồn…';
 try{const results=await Promise.allSettled([fetchCSV(SOURCES.stock),fetchCSV(SOURCES.price),fetchCSV(SOURCES.specs)]);if(results[0].status==='rejected'||results[1].status==='rejected')throw Error('Không tải được '+[results[0].status==='rejected'?'tồn kho':'',results[1].status==='rejected'?'bảng giá':''].filter(Boolean).join(' và '));
 const specFailed=results[2].status==='rejected';const built=buildData(results[0].value,results[1].value,specFailed?[]:results[2].value);if(!built.data.length)throw Error('Không có dòng giá hợp lệ. Cần kiểm tra nguồn Sheets.');
 const old=new Map(items.map(i=>[i.key,i]));for(const i of built.data){const previous=old.get(i.key);if(previous){const changes=[];if(previous.stock!==i.stock)changes.push('Tồn đổi');if(JSON.stringify(previous.programs.map(p=>[p.price,p.km,p.date]).sort())!==JSON.stringify(i.programs.map(p=>[p.price,p.km,p.date]).sort()))changes.push('Giá / CT đổi');i.change=changes.join(' · ');}else if(old.size)i.change='Mã mới';}
 const hadSelection=selected.size>0;items=built.data;selected.clear();opened.clear();lastSync=new Date().toLocaleTimeString('vi-VN',{timeZone:'Asia/Bangkok',hour:'2-digit',minute:'2-digit'});loadNote=[specFailed?'Chưa tải được thông số.':'',built.invalid?built.invalid+' dòng giá không hợp lệ đã bỏ qua.':'',built.duplicates?'Có mã tồn trùng: tạm ghi chưa rõ tồn để tránh cộng sai.':''].filter(Boolean).join(' ');filter();if(hadSelection)toast('Đã cập nhật. Lựa chọn cũ được bỏ để tránh báo nhầm.');
 }catch(e){$('status').textContent=e.message+(items.length?' · Đang giữ dữ liệu cũ từ '+lastSync+'.':' · Bấm MỚI để thử lại.');$('status').classList.add('error');if(!items.length)$('list').replaceChildren(el('div','empty','Chưa tải được dữ liệu. Kiểm tra kết nối và quyền xuất bản Sheets.'));}
 finally{loading=false;$('reload').disabled=false;$('copySelected').disabled=false;}}
function filter(){const words=fold($('search').value).trim().split(/\s+/).filter(Boolean);visible=items.filter(i=>{const target=fold([i.model,i.name,i.spec,...i.programs.map(p=>p.km)].join(' '));return words.every(w=>target.includes(w)||compact(i.model).includes(compact(w))&&compact(w)!=='')&&(!brand||target.includes(fold(brand)))&&($('stockFilter').value==='all'||($('stockFilter').value==='unknown'?i.stock===null:i.stock!==null&&i.stock>0));});render();}
function toggle(i){if(i.programs.some(p=>selected.has(p.id)))i.programs.forEach(p=>selected.delete(p.id));else selected.add(i.default.id);render();}
function check(checked,fn,label){const c=el('input','check');c.type='checkbox';c.checked=checked;c.setAttribute('aria-label',label);c.addEventListener('change',fn);return c;}
function render(){const fragment=document.createDocumentFragment();for(const i of visible){const any=i.programs.some(p=>selected.has(p.id)),card=el('article','card'+(any?' selected':'')),row=el('div','row');const mainCheck=check(any,()=>toggle(i),'Chọn '+i.model);mainCheck.indeterminate=any&&!selected.has(i.default.id);row.append(mainCheck);const info=el('div');info.append(el('div','model',i.model),el('div','name',i.name));if(i.spec)info.append(el('div','spec',i.spec));if(i.change)info.append(el('span','badge',i.change));const tools=el('div','tools');if(i.programs.length>1)tools.append(button((opened.has(i.key)?'▴ Ẩn':'▾ Xem')+' '+i.programs.length+' mức giá',()=>{opened.has(i.key)?opened.delete(i.key):opened.add(i.key);render();}));tools.append(button('Thông số',()=>{editing=i;$('specTitle').textContent='Thông số · '+i.model;$('specInput').value=i.spec;$('specDialog').showModal();}));info.append(tools);row.append(info);row.append(el('div','stock'+(i.stock===null||i.stock<=0?' muted':''),i.stock===null?'Tồn: chưa rõ':'Tồn: '+i.stock.toLocaleString('vi-VN')));const quote=el('div','quote');quote.append(el('div','price',money(i.default.price)),el('div','program',i.default.km),button('📋 Copy giá',()=>copyText(singleText(i,i.default)),'primary'));row.append(quote);card.append(row);
 if(opened.has(i.key)&&i.programs.length>1){const sub=el('div','sub');for(const p of i.programs){const line=el('div','subline');line.append(check(selected.has(p.id),()=>{selected.has(p.id)?selected.delete(p.id):selected.add(p.id);render();},'Chọn '+i.model+' '+money(p.price)),el('div','subprice'+(p.price===i.min?' best':''),money(p.price)),el('div','program',p.km+(p.date?'\nNgày CT: '+p.date:'')+(p.newToday?' · CT mới hôm nay':'')),button('📋 Copy',()=>copyText(singleText(i,p))));sub.append(line);}card.append(sub);}fragment.append(card);}
 if(!visible.length)fragment.append(el('div','empty','Không có sản phẩm phù hợp. Thử đổi từ khóa hoặc bộ lọc tồn.'));$('list').replaceChildren(fragment);$('count').textContent=selected.size;$('selectAll').textContent=visible.length&&visible.every(i=>selected.has(i.default.id))?'Bỏ chọn tất cả':'Chọn tất cả';$('status').classList.remove('error');$('status').textContent=visible.length+'/'+items.length+' sản phẩm · Đồng bộ '+lastSync+' · Giá đại diện ưu tiên CT có chữ “lẻ”, nếu không có lấy giá cao nhất. '+loadNote;}
function singleText(i,p){return i.model+' · '+i.name+' — Giá: '+money(p.price)+(p.km==='-'?'':' — CT: '+p.km);}
async function copyText(text){try{if(!navigator.clipboard?.writeText)throw Error();await navigator.clipboard.writeText(text);toast('Đã copy báo giá');}catch{$('manualText').value=text;$('manual').showModal();$('manualText').focus();$('manualText').select();}}
function copySelected(){const groups=new Map();for(const i of items)for(const p of i.programs)if(selected.has(p.id)){const label=p.km==='-'?'BÁO GIÁ':p.km;if(!groups.has(label))groups.set(label,[]);groups.get(label).push(i.model+' · '+i.name+' — '+money(p.price));}if(!groups.size)return toast('Chọn ít nhất một mức giá');let text='📣 BÁO GIÁ VIỆT TUẤN\n';for(const [label,lines] of groups)text+='\n'+label+'\n'+lines.map(l=>'• '+l).join('\n')+'\n';copyText(text.trim());}
for(const name of ['Tất cả','Panasonic','Daikin','Toshiba','Sharp','Electrolux','Hitachi','Aufit','Sanaky']){$('chips').append(button(name,e=>{brand=name==='Tất cả'?'':name;for(const b of $('chips').children)b.classList.toggle('active',b===e.currentTarget);filter();},name==='Tất cả'?'active':''));}
$('search').addEventListener('input',filter);$('stockFilter').addEventListener('change',filter);$('reload').addEventListener('click',load);$('copySelected').addEventListener('click',copySelected);$('reset').addEventListener('click',()=>{selected.clear();render();});$('selectAll').addEventListener('click',()=>{const all=visible.length&&visible.every(i=>selected.has(i.default.id));for(const i of visible)if(all)i.programs.forEach(p=>selected.delete(p.id));else selected.add(i.default.id);render();});$('closeManual').addEventListener('click',()=>$('manual').close());$('cancelSpec').addEventListener('click',()=>$('specDialog').close());$('saveSpec').addEventListener('click',()=>{if(!editing)return;const value=$('specInput').value.trim();const next={...custom};delete next[String(editing.model).trim().toUpperCase().normalize()];if(value)next[editing.key]=value;else delete next[editing.key];try{localStorage.setItem('CUSTOM_SPECS_CACHE',JSON.stringify(next));}catch{return toast('Không lưu được trên thiết bị. Thử kiểm tra quyền lưu của trình duyệt.');}custom=next;editing.spec=value||editing.sheetSpec;$('specDialog').close();filter();});
load();
</script>
</html>
